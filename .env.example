# Self-Hosted Pageflow Environment Configuration
# Copy this to .env and customize for your deployment
# The setup.sh script will auto-generate secure values for most fields

# === SECURITY ===
# All security keys are auto-generated during setup
SECRET_KEY_BASE=your_secret_key_here_auto_generated_by_setup
SYMMETRIC_ENC_KEY=your_symmetric_enc_key_auto_generated_by_setup  
SYMMETRIC_ENC_IV=your_symmetric_enc_iv_auto_generated_by_setup

# === DATABASE ===
# Auto-generated during setup with secure random passwords
MYSQL_ROOT_PASSWORD=your_mysql_root_password_auto_generated_by_setup
MYSQL_PASSWORD=your_mysql_password_auto_generated_by_setup

# === APPLICATION ===
# Auto-detected by setup script (replace with your server's IP for production)
PAGEFLOW_HOST=localhost:3000
RAILS_ENV=production
DEFAULT_LOCALE=en

# === PORT CONFIGURATION ===
# External ports - customize if you have port conflicts
PAGEFLOW_HOST_PORT=3000           # Pageflow web interface
MINIO_API_HOST_PORT=9000          # MinIO S3 API for browser uploads
MINIO_CONSOLE_HOST_PORT=9001      # MinIO admin console

# === STORAGE (MinIO S3-Compatible) ===
# MinIO credentials (change these in production for security)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# S3 bucket names
S3_BUCKET=pageflow-main
S3_OUTPUT_BUCKET=pageflow-output

# MinIO endpoints
# Internal: Used by Rails app (Docker hostname)
S3_ENDPOINT_INTERNAL=http://pageflow_minio:9000

# External: Used by browsers (auto-configured by setup script)
S3_ENDPOINT_EXTERNAL=http://localhost:9000

# MinIO console URLs (auto-configured by setup script)
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://localhost:9000

# === TRANSCODING ===
# Video transcoding configuration
MAX_CONCURRENT_JOBS=4
GPU_ACCELERATION=true
TRANSCODER_SERVICE_KEY=pageflow-transcoder
TRANSCODER_BASE_URL=http://pageflow_transcoder:8080